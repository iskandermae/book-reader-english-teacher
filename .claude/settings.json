{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/doc/pm-state.md\""
          }
        ]
      }
    ],
    "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "powershell.exe -NoProfile -Command \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\tada.wav').PlaySync()\""
            }
          ]
        }
      ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet --version)",
      "Bash(dotnet workload *)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet --list-runtimes)",
      "Bash(dotnet new *)",
      "Bash(dotnet sln *)",
      "Bash(dotnet add *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git check-ignore *)",
      "Bash(dotnet tool *)",
      "Bash(dotnet ef *)",
      "Bash(dotnet run *)",
      "Bash(dotnet nuget *)"
    ]
  }
}
