{
  "openapi": "3.1.1",
  "info": {
    "title": "BookReader.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Lists all books, last opened first, then most recently imported. Empty list when there are none.",
        "responses": {
          "200": {
            "description": "The books, without chapter or paragraph text.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookSummaryResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookSummaryResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookSummaryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Imports a book from one or more .txt files (merged in natural file-name order): splits it into chapters and paragraphs and stores it.",
        "requestBody": {
          "description": "The .txt files, sent as repeated `file` parts. They are merged in natural file-name order, not upload order.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/IFormFile"
                    }
                  },
                  "Title": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The book was imported.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBookResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBookResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBookResponse"
                }
              }
            }
          },
          "400": {
            "description": "No files, or a file is not .txt, is empty or is not UTF-8 (the detail names the file), or the chapter pattern setting is invalid. Nothing is saved.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}/chapters": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Lists the chapters of a book in reading order, without paragraph text.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The book title and its chapters.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BookChaptersResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookChaptersResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookChaptersResponse"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}/chapters/{index}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Gets one whole chapter: its title and all paragraphs in order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "index",
            "in": "path",
            "description": "Zero-based chapter index.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The chapter text.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterResponse"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id, or no chapter with this index.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}/position": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Gets where the reader stopped in a book; chapter 0, paragraph 0 when nothing is saved. Does not change the last-opened time.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The saved position.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingPositionDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingPositionDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingPositionDto"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Saves where the reader stopped and sets the book's last-opened time to now.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Chapter and paragraph index.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingPositionDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingPositionDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingPositionDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The position was saved."
          },
          "400": {
            "description": "The chapter does not exist, or the paragraph index is negative or not below the chapter's paragraph count.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}": {
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Deletes a book together with its chapters and paragraphs.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The book was deleted."
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/sort-names": {
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Sorts file names in the order the import merges them (natural order: ch2 before ch10, case-insensitive). Pure function: no files, no database.",
        "requestBody": {
          "description": "The names to sort.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortNamesRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SortNamesRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SortNamesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The same names in natural order.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Reports that the API is running.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/llm/status": {
      "get": {
        "tags": [
          "Llm"
        ],
        "summary": "Checks whether the LLM server (Ollama) is reachable. Always returns 200; a problem is reported in the error field.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LlmStatus"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmStatus"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/llm/models": {
      "get": {
        "tags": [
          "Llm"
        ],
        "summary": "Lists the names of the installed models.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Ollama is not reachable; the detail field says how to fix it.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/llm/test": {
      "post": {
        "tags": [
          "Llm"
        ],
        "summary": "Sends a prompt to the chosen model and streams the answer as Server-Sent Events.\r\nEach chunk is an event with a JSON string as data (for example `data: \"Hello\"`); the stream ends with `event: done`.\r\nIf the model fails after the stream started, an `event: error` with the message as data is sent instead.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LlmTestRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LlmTestRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LlmTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Blank prompt, no model chosen in settings, or the chosen model is not installed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Ollama is not reachable; the detail field says how to fix it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/llm/translate": {
      "post": {
        "tags": [
          "Llm"
        ],
        "summary": "Translates the selected text into the native language (setting `language.native`, Ukrainian by default) and streams the translation.\r\nThe stream format is the same as in the test endpoint. Only `text` is translated; `context` is not used yet (kept for custom prompts).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslateRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslateRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TranslateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Blank text, no model chosen in settings, or the chosen model is not installed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Ollama is not reachable; the detail field says how to fix it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/scratchpad": {
      "get": {
        "tags": [
          "Scratchpad"
        ],
        "summary": "Gets the scratchpad text (one per app); empty when never saved.",
        "responses": {
          "200": {
            "description": "The saved text.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ScratchpadDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScratchpadDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScratchpadDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Scratchpad"
        ],
        "summary": "Replaces the scratchpad text.",
        "requestBody": {
          "description": "The new text (may be empty to clear it).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScratchpadDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ScratchpadDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ScratchpadDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The text was saved.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ScratchpadDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScratchpadDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScratchpadDto"
                }
              }
            }
          },
          "400": {
            "description": "The text is longer than 200,000 characters. Nothing is saved.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Returns all settings as a key/value map. Settings never saved have their default value.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Updates one or more settings. The request is all or nothing; returns all settings after the update.",
        "requestBody": {
          "description": "Key/value map. Only known keys are accepted; values may be at most 1000 characters. reader.fontSize: small|medium|large|xlarge; reader.theme: light|dark; reader.width: narrow|medium|wide; reader.panelWidth: whole number 20-70 (percent, default 40).",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown key or invalid value; the detail field explains what to fix.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookChaptersResponse": {
        "required": [
          "bookId",
          "title",
          "chapters"
        ],
        "type": "object",
        "properties": {
          "bookId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Book id.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Book title."
          },
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChapterSummaryResponse"
            },
            "description": "Chapters ordered by index."
          }
        },
        "description": "A book's chapter list."
      },
      "BookSummaryResponse": {
        "required": [
          "id",
          "title",
          "chapterCount",
          "importedAt",
          "lastOpenedAt"
        ],
        "type": "object",
