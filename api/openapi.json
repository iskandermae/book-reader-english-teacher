{
  "openapi": "3.1.1",
  "info": {
    "title": "BookReader.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Lists all books, last opened first, then most recently imported. Empty list when there are none.",
        "responses": {
          "200": {
            "description": "The books, without chapter or paragraph text.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookSummaryResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookSummaryResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookSummaryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Imports a .txt book: splits it into chapters and paragraphs and stores it.",
        "requestBody": {
          "description": "The .txt file and an optional title.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "File": {
                    "$ref": "#/components/schemas/IFormFile"
                  },
                  "Title": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The book was imported.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBookResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBookResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBookResponse"
                }
              }
            }
          },
          "400": {
            "description": "The file is not .txt, is empty, is not UTF-8, or the chapter pattern setting is invalid; the detail field explains what to fix.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}/chapters": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Lists the chapters of a book in reading order, without paragraph text.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The book title and its chapters.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BookChaptersResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookChaptersResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookChaptersResponse"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}/chapters/{index}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Gets one whole chapter: its title and all paragraphs in order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "index",
            "in": "path",
            "description": "Zero-based chapter index.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The chapter text.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterResponse"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id, or no chapter with this index.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}/position": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Gets where the reader stopped in a book; chapter 0, paragraph 0 when nothing is saved. Does not change the last-opened time.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The saved position.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingPositionDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingPositionDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingPositionDto"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Saves where the reader stopped and sets the book's last-opened time to now.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Chapter and paragraph index.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingPositionDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingPositionDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingPositionDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The position was saved."
          },
          "400": {
            "description": "The chapter does not exist, or the paragraph index is negative or not below the chapter's paragraph count.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}": {
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Deletes a book together with its chapters and paragraphs.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Book id.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The book was deleted."
          },
          "404": {
            "description": "No book with this id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Reports that the API is running.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Returns all settings as a key/value map. Settings never saved have their default value.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Updates one or more settings. The request is all or nothing; returns all settings after the update.",
        "requestBody": {
          "description": "Key/value map. Only known keys are accepted; values may be at most 1000 characters.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown key or invalid value; the detail field explains what to fix.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookChaptersResponse": {
        "required": [
          "bookId",
          "title",
          "chapters"
        ],
        "type": "object",
        "properties": {
          "bookId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Book id.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Book title."
          },
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChapterSummaryResponse"
            },
            "description": "Chapters ordered by index."
          }
        },
        "description": "A book's chapter list."
      },
      "BookSummaryResponse": {
        "required": [
          "id",
          "title",
          "chapterCount",
          "importedAt",
          "lastOpenedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Book id.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Book title."
          },
          "chapterCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of chapters.",
            "format": "int32"
          },
          "importedAt": {
            "type": "string",
            "description": "When the book was imported (UTC).",
            "format": "date-time"
          },
          "lastOpenedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the book was last opened (UTC); null if never opened.",
            "format": "date-time"
          }
        },
        "description": "A book in the library list."
      },
      "ChapterResponse": {
        "required": [
          "bookId",
          "index",
          "title",
          "paragraphs"
        ],
        "type": "object",
        "properties": {
          "bookId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Book id.",
            "format": "int32"
          },
          "index": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Zero-based chapter index.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Chapter title."
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paragraph texts in reading order; the array position is the paragraph index."
          }
        },
        "description": "One chapter with its text."
      },
      "ChapterSummaryResponse": {
        "required": [
          "index",
          "title",
          "paragraphCount"
        ],
        "type": "object",
        "properties": {
          "index": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Zero-based chapter index; use it to fetch the chapter text.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Chapter title."
          },
          "paragraphCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of paragraphs in the chapter.",
            "format": "int32"
          }
        },
        "description": "A chapter in a book's chapter list."
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always \"ok\" when the API is up."
          }
        },
        "description": "Response of the health endpoint."
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImportBookResponse": {
        "required": [
          "id",
          "title",
          "chapterCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Book id.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Book title."
          },
          "chapterCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of chapters found.",
            "format": "int32"
          }
        },
        "description": "The imported book."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReadingPositionDto": {
        "required": [
          "chapterIndex",
          "paragraphIndex"
        ],
        "type": "object",
        "properties": {
          "chapterIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Chapter index.",
            "format": "int32"
          },
          "paragraphIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Paragraph index inside the chapter (array position in the chapter response).",
            "format": "int32"
          }
        },
        "description": "Where the reader stopped in a book. Both values are zero-based."
      }
    }
  },
  "tags": [
    {
      "name": "Books"
    },
    {
      "name": "Health"
    },
    {
      "name": "Settings"
    }
  ]
}
